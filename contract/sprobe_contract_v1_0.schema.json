{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprobe.example.com/schemas/sprobe_contract_v1_0.schema.json",
  "title": "Sprobe Protocol & API Contract v1.0",
  "description": "Single Source of Truth JSON Schema shared by Sprobe Backend (rust_v1_3.md) and Console UI (sprobe_v1_2.md).",
  "$defs": {
    "SectionStatus": {
      "type": "string",
      "enum": [
        "ok",
        "partial",
        "failed",
        "unsupported",
        "timeout"
      ]
    },
    "Quality": {
      "type": "string",
      "enum": [
        "measured",
        "derived",
        "estimated"
      ]
    },
    "HealthStatus": {
      "type": "string",
      "enum": [
        "ok",
        "degraded",
        "critical",
        "unknown"
      ]
    },
    "SectionMeta": {
      "type": "object",
      "required": [
        "status",
        "quality",
        "sampled_at",
        "age_seconds",
        "errors"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/SectionStatus"
        },
        "quality": {
          "$ref": "#/$defs/Quality"
        },
        "sampled_at": {
          "type": "string",
          "format": "date-time"
        },
        "age_seconds": {
          "type": "number",
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "Capabilities": {
      "type": "object",
      "required": [
        "cpu_modes",
        "cpu_frequency",
        "memory_available",
        "swap",
        "filesystem_inodes",
        "disk_io_counters",
        "network_speed",
        "process_top",
        "process_io"
      ],
      "properties": {
        "cpu_modes": {
          "type": "boolean"
        },
        "cpu_frequency": {
          "type": "boolean"
        },
        "memory_available": {
          "type": "boolean"
        },
        "swap": {
          "type": "boolean"
        },
        "filesystem_inodes": {
          "type": "boolean"
        },
        "disk_io_counters": {
          "type": "boolean"
        },
        "network_speed": {
          "type": "boolean"
        },
        "process_top": {
          "type": "boolean"
        },
        "process_io": {
          "type": "boolean"
        },
        "cgroup_metrics": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "Snapshot": {
      "type": "object",
      "required": [
        "schema_version",
        "snapshot_id",
        "sequence",
        "collected_at",
        "agent",
        "host",
        "collection",
        "cpu",
        "memory",
        "filesystems",
        "disks",
        "network",
        "load",
        "processes",
        "uptime",
        "health",
        "events"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "snapshot_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "agent": {
          "type": "object",
          "required": [
            "agent_id",
            "instance_id",
            "version",
            "hostname",
            "os",
            "arch",
            "labels"
          ],
          "properties": {
            "agent_id": {
              "type": "string",
              "format": "uuid"
            },
            "instance_id": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "string"
            },
            "hostname": {
              "type": "string",
              "maxLength": 256
            },
            "os": {
              "type": "string"
            },
            "arch": {
              "type": "string"
            },
            "labels": {
              "type": "object",
              "maxProperties": 32,
              "additionalProperties": {
                "type": "string",
                "maxLength": 256
              }
            }
          }
        },
        "host": {
          "type": "object",
          "required": [
            "hostname",
            "os_name",
            "kernel",
            "architecture",
            "virtualization",
            "cpu_model",
            "boot_time"
          ],
          "properties": {
            "hostname": {
              "type": [
                "string",
                "null"
              ]
            },
            "os_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "kernel": {
              "type": [
                "string",
                "null"
              ]
            },
            "architecture": {
              "type": [
                "string",
                "null"
              ]
            },
            "virtualization": {
              "type": [
                "string",
                "null"
              ]
            },
            "cpu_model": {
              "type": [
                "string",
                "null"
              ]
            },
            "boot_time": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        },
        "collection": {
          "type": "object",
          "required": [
            "interval_seconds",
            "warmup",
            "partial",
            "capabilities",
            "unsupported_reasons"
          ],
          "properties": {
            "interval_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "warmup": {
              "type": "boolean"
            },
            "partial": {
              "type": "boolean"
            },
            "capabilities": {
              "$ref": "#/$defs/Capabilities"
            },
            "unsupported_reasons": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "unsupported_platform",
                  "permission_denied",
                  "not_configured",
                  "kernel_too_old",
                  "temporarily_unavailable"
                ]
              }
            }
          }
        },
        "cpu": {
          "allOf": [
            {
              "$ref": "#/$defs/SectionMeta"
            },
            {
              "type": "object",
              "required": [
                "logical_count",
                "physical_count",
                "total",
                "cores"
              ],
              "properties": {
                "truncated": {
                  "type": "boolean"
                },
                "logical_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "physical_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "total": {
                  "type": "object"
                },
                "cores": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "cpu",
                      "usage_ratio",
                      "idle_ratio"
                    ],
                    "properties": {
                      "cpu": {
                        "type": "string"
                      },
                      "usage_ratio": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 1
                      },
                      "idle_ratio": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 1
                      },
                      "iowait_ratio": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 1
                      },
                      "steal_ratio": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "minimum": 0,
                        "maximum": 1
                      },
                      "frequency_hertz": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 0
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "memory": {
          "$ref": "#/$defs/SectionMeta"
        },
        "filesystems": {
          "$ref": "#/$defs/SectionMeta"
        },
        "disks": {
          "$ref": "#/$defs/SectionMeta"
        },
        "network": {
          "$ref": "#/$defs/SectionMeta"
        },
        "load": {
          "$ref": "#/$defs/SectionMeta"
        },
        "processes": {
          "$ref": "#/$defs/SectionMeta"
        },
        "uptime": {
          "$ref": "#/$defs/SectionMeta"
        },
        "health": {
          "type": "object",
          "required": [
            "status",
            "status_code",
            "since",
            "recovered_at",
            "checks"
          ],
          "properties": {
            "status": {
              "$ref": "#/$defs/HealthStatus"
            },
            "status_code": {
              "type": "integer",
              "enum": [
                0,
                1,
                2,
                3
              ]
            },
            "since": {
              "type": "string",
              "format": "date-time"
            },
            "recovered_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "IngestBatch": {
      "type": "object",
      "required": [
        "schema_version",
        "batch_id",
        "agent_id",
        "instance_id",
        "created_at",
        "sequence_first",
        "sequence_last",
        "snapshot_count",
        "snapshots"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "batch_id": {
          "type": "string",
          "format": "uuid"
        },
        "agent_id": {
          "type": "string",
          "format": "uuid"
        },
        "instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "sequence_first": {
          "type": "integer",
          "minimum": 0
        },
        "sequence_last": {
          "type": "integer",
          "minimum": 0
        },
        "snapshot_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 0
              },
              "to": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "snapshots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Snapshot"
          }
        }
      }
    },
    "HeartbeatRequest": {
      "type": "object",
      "required": [
        "schema_version",
        "agent_id",
        "instance_id",
        "sent_at",
        "uptime_seconds",
        "ready",
        "warmup",
        "health_status",
        "health_status_code",
        "last_sequence",
        "wal_snapshots"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "agent_id": {
          "type": "string",
          "format": "uuid"
        },
        "instance_id": {
          "type": "string",
          "format": "uuid"
        },
        "sent_at": {
          "type": "string",
          "format": "date-time"
        },
        "uptime_seconds": {
          "type": "number",
          "minimum": 0
        },
        "ready": {
          "type": "boolean"
        },
        "warmup": {
          "type": "boolean"
        },
        "health_status": {
          "$ref": "#/$defs/HealthStatus"
        },
        "health_status_code": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            3
          ]
        },
        "last_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "wal_snapshots": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "IngestSuccessResponse": {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "batch_id",
        "accepted",
        "duplicates",
        "rejected",
        "server_time"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "partial"
          ]
        },
        "batch_id": {
          "type": "string",
          "format": "uuid"
        },
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "duplicates": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sequence",
              "code",
              "message"
            ],
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 0
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        },
        "server_time": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "retryable",
            "request_id",
            "server_time"
          ],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "invalid_json",
                "invalid_gzip",
                "unsupported_schema",
                "invalid_query",
                "unauthorized",
                "unauthenticated",
                "forbidden",
                "public_detail_disabled",
                "not_found",
                "request_timeout",
                "conflict",
                "payload_too_large",
                "validation_failed",
                "rate_limited",
                "internal",
                "upstream_unavailable"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            },
            "request_id": {
              "type": "string"
            },
            "server_time": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    }
  }
}
